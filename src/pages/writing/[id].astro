---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const essays = await getCollection('writing');
  return essays.map((essay) => ({
    params: { id: essay.id },
    props: { essay },
  }));
}

const { essay } = Astro.props;
const { Content } = await render(essay);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---

<Base
  title={`${essay.data.title} — Jorge Piano Simões`}
  description={essay.data.description}
  type="article"
  publishedTime={essay.data.date}
>
  <Fragment slot="head">
    {essay.data.pdf && essay.data.author && <>
      <meta name="citation_title" content={essay.data.title} />
      <meta name="citation_author" content={essay.data.author} />
      <meta name="citation_publication_date" content={essay.data.date.toISOString().slice(0, 10).replaceAll('-', '/')} />
      <meta name="citation_pdf_url" content={new URL(essay.data.pdf, Astro.site).href} />
    </>}
  </Fragment>
  <main class="essay">
    <nav class="crumb label">
      <a href="/"><span aria-hidden="true">← </span>Jorge Piano Simões</a>
    </nav>
    <article>
      <header class="reveal">
        <time class="label" datetime={essay.data.date.toISOString().slice(0, 10)}>
          {fmt(essay.data.date)}
        </time>
        <h1>{essay.data.title}</h1>
        {essay.data.author && <p>{essay.data.author}</p>}
        {essay.data.pdf && <p class="essay-download"><a href={essay.data.pdf} download>Download article (PDF)</a></p>}
      </header>
      <div class="prose">
        <Content />
      </div>
      {essay.data.license && essay.data.licenseUrl &&
        <footer class="essay-license">Article and figures · <a rel="license" href={essay.data.licenseUrl}>{essay.data.license}</a></footer>}
    </article>
  </main>
</Base>
